{
  "manifest_version": 3,
  "name": "Jarvis",
  "version": "1.0.0",
  "description": "Permet à Jarvis, ton assistant vocal local, de piloter les vidéos et les pages de ce navigateur.",
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["config.js", "actions.js", "background.js"] },
  "action": { "default_title": "Jarvis" },
  "browser_specific_settings": { "gecko": { "id": "jarvis@sacha9214", "strict_min_version": "128.0" } }
}
